# Spotify: https://developer.spotify.com/dashboard -> Twoja aplikacja -> Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Musi być identyczny z jednym z "Redirect URIs" w ustawieniach aplikacji Spotify.
# Lokalnie Spotify wymaga 127.0.0.1 (nie "localhost").
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Losowy ciąg min. 32 znaków do szyfrowania ciasteczka sesji,
# np. wynik: openssl rand -base64 32
SESSION_SECRET=

# Supabase: Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
